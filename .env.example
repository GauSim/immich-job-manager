# Immich Album Jobs – non-secret settings. Copy to .env and adjust.
# Secrets (API key, app password) go into ./secrets/*, never into this file.

# Immich API base URL, including /api. Use the container name on the shared Docker network.
IMMICH_URL=http://immich_server:2283/api

# Dev only: plain API key instead of IMMICH_API_KEY_FILE (docker-compose sets the _FILE variant).
# IMMICH_API_KEY=

# password (default) or forward-auth (only behind Authelia/Authentik/...).
AUTH_MODE=password

# Time zone for cron schedules.
TZ=Europe/Berlin

# Run limits.
MAX_CONCURRENT_RUNS=2
MAX_FILE_READS=4

# HTTP port inside the container.
PORT=3000

# Python ML worker (phase 9, optional).
# PY_WORKER_URL=http://py-worker:8000
