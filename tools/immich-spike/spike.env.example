# Copy to spike.env (not committed) and fill in.

# Immich on the same NAS (published port 2283), or use http://<nas-ip>:2283/api
IMMICH_URL=http://host.docker.internal:2283/api
# API key with: server.about, asset.read, asset.view, asset.download, album.read,
# album.create, albumAsset.create, albumAsset.delete
IMMICH_API_KEY=

# Optional: id of a real iPhone screenshot for the Range / UserComment test
SPIKE_ASSET_ID=
# Optional: test album name
# SPIKE_ALBUM_NAME=immich-album-jobs-spike
